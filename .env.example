GROQ_API_KEY=your_groq_api_key_here

# Text grading model
GRADING_MODEL=openai/gpt-oss-20b

# Vision/OCR model
VISION_MODEL=qwen/qwen3.6-27b

# Start low. Increase only after testing your Groq limits.
MAX_WORKERS=3

# Papers below this confidence go to manual review.
REVIEW_THRESHOLD=0.75

# If extracted PDF text is below this amount, use Vision OCR.
MIN_TEXT_CHARS_FOR_OCR=300

# Safety limit for Vision OCR.
MAX_VISION_PAGES=20
